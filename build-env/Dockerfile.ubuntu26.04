# =============================================================================
# filemanageClient 编译环境：Ubuntu 26.04（deb 产物）
#
# 镜像命名规范：filemanage-client-build:<平台标签>，本平台标签 = ubuntu26.04
# 产物：deb（对应产物文件 filemanageClient_ubuntu26.04_<版本号>.deb）
# 与 24.04 环境同构（26.04 源内 libwebkit2gtk-4.1-dev 等包已实测可用）
#
# 构建（在工程根目录）：
#   docker build -f build-env/Dockerfile.ubuntu26.04 -t filemanage-client-build:ubuntu26.04 build-env
# 使用（通常经 ./build.sh 调用）：
#   docker run --rm -v $PWD:/src -v fmc-work-ubuntu26.04:/work -v fmc-cargo-ubuntu26.04:/opt/cargo \
#     -v fmc-npm:/opt/npm -v fmc-cache:/root/.cache \
#     filemanage-client-build:ubuntu26.04 bash /src/build-env/container-build.sh "deb" release "" ubuntu26.04
# =============================================================================
FROM ubuntu:26.04
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl wget xz-utils git rsync file \
        build-essential pkg-config patchelf \
        libssl-dev libxdo-dev librsvg2-dev libayatana-appindicator3-dev \
        libwebkit2gtk-4.1-dev libjavascriptcoregtk-4.1-dev libsoup-3.0-dev \
    && rm -rf /var/lib/apt/lists/*

ARG NODE_VERSION=22.20.0
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.txz \
    && tar -xJ --strip-components=1 -C /usr/local -f /tmp/node.txz && rm -f /tmp/node.txz \
    && node --version && npm --version

ARG RUST_TOOLCHAIN=stable
RUN export CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/opt/rustup && \
        curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
    && /usr/local/cargo/bin/rustc --version

ENV CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    NPM_CONFIG_CACHE=/opt/npm \
    PATH=/usr/local/cargo/bin:/opt/cargo/bin:/usr/local/bin:${PATH}
RUN mkdir -p /opt/cargo /opt/npm /work /src

WORKDIR /src
ENTRYPOINT []
CMD ["sleep", "infinity"]
